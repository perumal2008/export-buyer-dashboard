# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Primary Live B2B Buyer & Contact APIs (Optional — automatic live open-data fallback runs if blank)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional OpenCorporates Token (If blank, backend tries OpenCorporates and automatically cascades to live GLEIF + UN Comtrade APIs)
OPENCORPORATES_API_KEY=

# Outbound Email / SMTP Configuration (Optional — built-in Preview/Test mode runs if blank)
# For Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and use a 16-char Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=GlobalTrade Export Desk
SMTP_FROM_EMAIL=
